# SignalPulse NG — Environment Configuration
# The foundation defaults to synthetic mode without credentials:
SIGNALPULSE_DATA_MODE=synthetic

# --- Optional Cloud Foundation (Disabled by default in this milestone) ---
# When testing the private evidence cloud preview locally:
# SIGNALPULSE_DATA_MODE=cloud_preview
# NEXT_PUBLIC_ENABLE_CLOUD_BACKUP=false
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# No service-role or secret key is used by this application.
# SIGNALPULSE_ATTACHMENTS_ENABLED=false
